# Regression: binary input must not be folded; supported UTF-8 inputs must be.
# Native default result format compares each named boolean result with 1.
# Membership/count checks do not depend on JSON hash iteration order.
--disable_query_log

SELECT JSON_LENGTH(TOKENIZE(_binary 'ABC abc', 'space')) = 2 AND JSON_CONTAINS(TOKENIZE(_binary 'ABC abc', 'space'), JSON_QUOTE('ABC')) AND JSON_CONTAINS(TOKENIZE(_binary 'ABC abc', 'space'), JSON_QUOTE('abc')) AS binary_preserves_case;

SELECT JSON_LENGTH(TOKENIZE(_utf8mb4 'ABC abc' COLLATE utf8mb4_bin, 'space')) = 1 AND JSON_CONTAINS(TOKENIZE(_utf8mb4 'ABC abc' COLLATE utf8mb4_bin, 'space'), JSON_QUOTE('abc')) AS utf8mb4_bin_folds_ascii;

SELECT JSON_LENGTH(TOKENIZE(_utf8mb4 'ABC abc' COLLATE utf8mb4_general_ci, 'space')) = 1 AND JSON_CONTAINS(TOKENIZE(_utf8mb4 'ABC abc' COLLATE utf8mb4_general_ci, 'space'), JSON_QUOTE('abc')) AS utf8mb4_general_ci_folds_ascii;

SELECT JSON_LENGTH(TOKENIZE(_utf8mb4 'ABC abc' COLLATE utf8mb4_unicode_ci, 'space')) = 1 AND JSON_CONTAINS(TOKENIZE(_utf8mb4 'ABC abc' COLLATE utf8mb4_unicode_ci, 'space'), JSON_QUOTE('abc')) AS utf8mb4_unicode_ci_folds_ascii;

# UTF-8 hex encodes uppercase/lowercase A-diaeresis without shell encoding loss.
SELECT JSON_LENGTH(TOKENIZE(CONVERT(0xC384424320C3A46263 USING utf8mb4) COLLATE utf8mb4_bin, 'space')) = 1 AND JSON_CONTAINS(TOKENIZE(CONVERT(0xC384424320C3A46263 USING utf8mb4) COLLATE utf8mb4_bin, 'space'), JSON_QUOTE(CONVERT(0xC3A46263 USING utf8mb4))) AS utf8mb4_bin_folds_unicode;

SELECT JSON_LENGTH(TOKENIZE(_binary '', 'space')) = 0 AS empty_binary_has_no_tokens;

SELECT JSON_LENGTH(TOKENIZE(_binary '   ', 'space')) = 0 AS binary_spaces_have_no_tokens;

SELECT JSON_LENGTH(TOKENIZE(_utf8mb4 '   ' COLLATE utf8mb4_bin, 'space')) = 0 AS utf8mb4_spaces_have_no_tokens;

--enable_query_log
