call DBMS_AI_SERVICE.DROP_AI_MODEL('ollama_empty_key_model');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('ollama_empty_key_endpoint');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('ollama_empty_key_model', '{"type":"completion","model_name":"development-model"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('ollama_empty_key_endpoint', '{"ai_model_name":"ollama_empty_key_model","scope":"all","url":"http://127.0.0.1:9/unreachable","access_key":"","provider":"ollama"}');
select provider from oceanbase.DBA_OB_AI_MODEL_ENDPOINTS where endpoint_name = 'ollama_empty_key_endpoint';
provider
ollama
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('ollama_empty_key_endpoint', '{"provider":"Ollama"}');
