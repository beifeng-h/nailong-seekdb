# The repository holds both Windows and Linux scripts. Keep the line endings
# that each one needs: LF for anything executed on Linux, CRLF for PowerShell.
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.cnf text eol=lf
*.ps1 text eol=crlf
*.txt text eol=lf

# Binary-ish assets stay untouched.
*.msi binary
*.png binary
*.ico binary
