# The SeekDB Windows installer is 150 MB and GitHub rejects git objects
# larger than 100 MB. deploy_seekdb.ps1 fetches it instead -- the exact URL
# and checksum live in seekdb/vendor/README.md.
seekdb/vendor/*.msi

# Python bytecode
__pycache__/
*.py[cod]
*.egg-info/

# Editor / OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini

# The upstream source snapshot used for the competition fix (278 MB) and its
# archive (126 MB) are local build inputs, not part of this deployment
# record. The archive also exceeds GitHub's 100 MB per-file limit.
seekdb-master/
seekdb-master.zip

# Build and runtime logs
seekdb/wsl/*.log